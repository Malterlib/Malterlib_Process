Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Process}"
{
	%Group "Process"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Process/^*"
		}
		%File "Source/*"
		%Group "Platform"
		{
			%File "Source/Platform/*"
			{
				Compile.Disabled true
				{
					!PlatformFamily PlatformFamilyFromFile
				}
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
	%Dependency "Lib_Malterlib_Concurrency"
	{
		Dependency.Indirect true
	}	
}

Property
{
	MalterlibLibrary_Process define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Process"
	{
		!!MalterlibLibrary_Process true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Process define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Process true
	}
}

%Target "Dll_Test_Malterlib_Helper_Process"
{
	Property
	{
		MalterlibHelperTest true
		MalterlibPostCopyProject "Tests"
		ProductName "Malterlib Test Dll"
	}
	Target
	{
		BaseName "Test_Malterlib_Helper_Process"
		Type "DynamicLibrary"
		Group "Helpers"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
	}
	%File "Test/Test_Malterlib_Process_DllMain.cpp"
	%Dependency "Lib_Malterlib"
}


%Group "{Test}/{Malterlib_Helper_Process}"
{
	Property
	{
		URLSchemeUnique define string = MalterlibFinalModuleDestination->HashUUID("AlphaNum")
		URLScheme define string
		URLScheme `mib@(URLSchemeUnique->Format("{sm6}"))`

		MalterlibURLScheme =+ {
			Protocols: [URLScheme]
			, Role: "Viewer"
			, Name: `@(ProductCompany->Sanitize()).@(Target:Target.Name->Sanitize()).Link`
		}
		{
			!!PlatformFamily "OSX"
		}

		MalterlibBundleIdentifier `@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize()).@(MalterlibFinalModuleDestination->HashUUID("AlphaNum"))`
		{
			!!PlatformFamily "OSX"
		}

		MalterlibBuildSpecifics =+ `#define DLaunchableScheme "@(URLScheme)"\r\n`
		{
		}

		MalterlibEnableBreakpad true
		{
			!!PlatformFamily "OSX"
		}
		MalterlibSigning false
		MalterlibTestOwnMain true
	}
	Target
	{
		Type "UIExecutable"
	}
	%Group "Helper Source"
	{
		
		%File "Test/Test_Malterlib_Process_Launchable_Main.cpp"
		%File "Test/Test_Malterlib_Process_Launchable_EventHandler.mm"
		{
			Compile.Disabled true
			{
				!PlatformFamily "OSX"
			}
		}
		%File "Test/Test_Malterlib_Process_Launchable_EventHandler.h"
	}
}


Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Helper_Process"
	MalterlibTestExtraGroups_Malterlib_Helper_Process define [string] = ["{Test}/{Malterlib_Helper_Process}"]
	MalterlibTestAutoAdd_Malterlib_Helper_Process define bool = false
}

%Group "{Test}/{Malterlib_Process}"
{
	Property
	{
		HelperAvailable define bool = HasProperty("Property", "URLScheme", "Workspace:*.Group:Helpers.Target:Malterlib_Helper_Process.Target:Malterlib_Helper_Process")
		
		URLScheme define string = HelperAvailable ? GetProperty("Property", "URLScheme", "Workspace:*.Group:Helpers.Target:Malterlib_Helper_Process.Target:Malterlib_Helper_Process") : "DummyScheme"

		MalterlibBuildSpecifics =+ `#define DLaunchableScheme "@(URLScheme)"\r\n`

		ProductVersionMajor "1"
		ProductVersionMinor "2"
		ProductVersionRevision "345"
		
		MalterlibExtraPListContents =+	"	<key>SecTaskAccess</key>\n"\
										"		<array>\n"\
										"			<string>allowed</string>\n"\
										"		</array>\n"
		{
			!!PlatformFamily "OSX"
		}
	}
	%Group "Tests"
	{
		%File "Test/Test_Malterlib_Process_ProcessLaunch.cpp"
		%File "Test/Test_Malterlib_Process_ProcessLaunchFeatures.cpp"
		%File "Test/Test_Malterlib_Process_StdIn.cpp"
		%File "Test/Test_Malterlib_Process_Info.cpp"
	}
	%Dependency {
		Name: "Exe_Test_Malterlib_Helper_Process"
		, Properties: {
			Dependency.Target: "Malterlib_Helper_Process"
		}
	}
	{
		!!PlatformFamily "OSX"
		Dependency.Link false
	}
	%Dependency "Dll_Test_Malterlib_Helper_Process"
	{
		Dependency.Link false
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Process"
	MalterlibTestExtraGroups_Malterlib_Process define [string] = ["{Test}/{Malterlib_Process}"]
}
